<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- Properties for all projects -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Localization for the ViciOne product family</Description>
        <Product>ViciOne Localization</Product>
        <Company>ViciOne open automation gmbh</Company>
        <Year>$([System.DateTime]::Now.Year)</Year>
        <Copyright>Copyright © $(Company) $(Year)</Copyright>
        <NeutralLanguage>en-US</NeutralLanguage>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- Enable XML documentation for all projects by default as EnforceCodeStyleInBuild relys on it, see https://github.com/dotnet/roslyn/issues/41640 -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- NuGet package configuration -->
    <PropertyGroup>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageProjectUrl>https://gitlab.com/vicione-oss/vicione/ui-libs/localization.git</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Authors>$(Company)</Authors>
    </PropertyGroup>

    <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
        <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath=""/>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Performance optimization for CI pipelines -->
    <PropertyGroup Condition="'$(CI)' != ''">
        <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
        <RunAnalyzers>true</RunAnalyzers>
    </PropertyGroup>

    <!-- Exclude test projects from publish / NuGet packaging -->
    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsPublishable>true</IsPublishable>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!-- Microsoft Testing Platform command line experience -->
    </PropertyGroup>

    <!-- Add Test.SDK / xUnit package references to test projects -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="NSubstitute.Analyzers.CSharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3.mtp-v2" />
    </ItemGroup>

    <!-- Configure xunit runner for test projects -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
        <Content Include="$(MSBuildThisFileDirectory)/tests/xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Exclude sample projects from publish / NuGet packaging -->
    <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples'))">
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <!-- No XML documentation for projects not shared as NuGet package -->
    <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples')) Or $(MSBuildProjectName.EndsWith('Tests'))">
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

</Project>
